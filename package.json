{
  "name": "@liuman/react-annotate",
  "version": "0.2.1",
  "homepage": "https://mxyg.github.io/react-annotate/",
  "description": "In-app visual annotation & kanban for React: pick any element, screenshot it, draw on it, and turn it into an assignable task — without leaving the app",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./src/styles.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "demo": "vite",
    "demo:build": "vite build",
    "prepublishOnly": "npm run type-check && npm run build:vite-plugin",
    "build:vite-plugin": "esbuild src/vite/annotate-source.ts --outfile=dist/vite.mjs --format=esm --platform=node --target=node20 && tsc src/vite/annotate-source.ts --declaration --emitDeclarationOnly --outDir dist --module esnext --moduleResolution bundler --target es2020 --types node --skipLibCheck && mv dist/annotate-source.d.ts dist/vite.d.ts"
  },
  "keywords": [
    "react",
    "annotation",
    "feedback",
    "screenshot",
    "kanban",
    "bug-report",
    "markup",
    "visual-feedback",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxyg/react-annotate.git"
  },
  "bugs": {
    "url": "https://github.com/mxyg/react-annotate/issues"
  },
  "peerDependencies": {
    "@zumer/snapdom": ">=2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@zumer/snapdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@zumer/snapdom": "^2.24.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.2.2"
  }
}
