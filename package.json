{
  "name": "@liuman/react-annotate",
  "version": "0.1.0",
  "description": "In-app visual annotation & kanban for React: pick any element, screenshot it, draw on it, and turn it into an assignable task — without leaving the app",
  "type": "module",
  "main": "./dist/react-annotate.cjs",
  "module": "./dist/react-annotate.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-annotate.js",
      "require": "./dist/react-annotate.cjs"
    },
    "./style.css": "./dist/react-annotate.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "annotation",
    "feedback",
    "screenshot",
    "kanban",
    "bug-report",
    "markup",
    "visual-feedback"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mxyg/react-annotate.git"
  },
  "bugs": {
    "url": "https://github.com/mxyg/react-annotate/issues"
  },
  "peerDependencies": {
    "@zumer/snapdom": ">=2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@zumer/snapdom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@zumer/snapdom": "^2.24.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.0"
  }
}
